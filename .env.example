# Copy this file to .env.local and fill in real values.
# NEVER commit a filled-in copy of this file.

# Neon PostgreSQL connection string (Settings -> Connection Details in Neon console)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Public base URL of the deployment, no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Building / site name shown in the UI and on generated PDFs
NEXT_PUBLIC_BUILDING_NAME=Marina Heights Residences

# IANA timezone for SLA calculations and every displayed timestamp.
# Africa/Nairobi (EAT, UTC+3, no DST). An unset or invalid value falls back to
# Asia/Dubai rather than throwing.
NEXT_PUBLIC_BUILDING_TZ=Africa/Nairobi

# Password assigned to every account created by the seeder.
# Required when NODE_ENV=production and must be at least 12 characters;
# the seeder refuses to run in production without it. Ignored unless set.
# DEMO_PASSWORD=change-me-to-something-unique
