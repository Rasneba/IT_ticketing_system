# Copy this file to .env.local and fill in real values.
# NEVER commit a filled-in copy of this file.

# Neon PostgreSQL connection string (Settings -> Connection Details in Neon console)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Public base URL of the deployment, no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Building / site name shown in the UI and on generated PDFs
NEXT_PUBLIC_BUILDING_NAME=Main Building

# IANA timezone for SLA calculations, e.g. Europe/Lisbon
NEXT_PUBLIC_BUILDING_TZ=Europe/Lisbon
